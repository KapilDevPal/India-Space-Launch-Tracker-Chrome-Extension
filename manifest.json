{
  "manifest_version": 3,
  "name": "India Space Launch Tracker",
  "version": "1.0.0",
  "description": "Track Indian space launches from ISRO and private companies with live countdowns, alerts, and notifications",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "India Space Launch Tracker"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://space.veerexa.com/*"
  ]
}