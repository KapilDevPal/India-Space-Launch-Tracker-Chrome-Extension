{
  "manifest_version": 3,
  "name": "ISRO launches & news unofficial",
  "version": "2.0.0",
  "description": "__MSG_appDesc__",
  "default_locale": "en",
  "icons": {
    "16": "icons/chopper_icon.png",
    "48": "icons/chopper_icon.png",
    "128": "icons/chopper_icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/chopper_icon.png",
      "48": "icons/chopper_icon.png",
      "128": "icons/chopper_icon.png"
    },
    "default_title": "ISRO launches & news unofficial"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://space.veerexa.com/*",
    "https://api.spaceflightnewsapi.net/*"
  ]
}