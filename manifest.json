{
  "manifest_version": 3,
  "name": "Indian Space Hub – ISRO Launch Tracker",
  "version": "1.1.0",
  "description": "Indian Space Hub tracks ISRO launches, Chandrayaan missions, PSLV rockets, live countdowns, satellite launches, and Indian space updates in real time.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Indian Space Hub"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://space.veerexa.com/*"
  ]
}