{
  "manifest_version": 3,
  "name": "Indian Space Hub – ISRO Launch Tracker",
  "version": "2.2.0",
  "description": "Track ISRO, Skyroot, Agnikul and Pixxel launches with live countdowns, mission alerts, and real-time Indian space updates.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Indian Space Hub"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://space.veerexa.com/*"
  ]
}